# Local development against the Django server running on this laptop.
# Only read by `npx expo start` (local Metro bundler). Cloud EAS builds do
# NOT read this file -see DEPLOYMENT.md; the same EXPO_PUBLIC_API_URL must
# also be set in eas.json's per-profile "env" block, which is deliberately
# left pointing at production so real builds are unaffected by this file.
#
# The phone must be on the same WiFi as this laptop for 192.168.0.56 to
# resolve. Django's ALLOWED_HOSTS already includes this address, and
# app.json sets android.usesCleartextTraffic so plain http:// is permitted.
EXPO_PUBLIC_API_URL=http://192.168.0.56:8000/api

# Production backend -swap with the line above to point the app back at the
# live server (e.g. when testing against real data). hrms.uktextiles.in is
# the FRONTEND (Vercel) now -pointing the app there would hit the React
# app's catch-all rewrite and get back index.html instead of JSON.
# EXPO_PUBLIC_API_URL=https://api.uktextiles.in/api

EXPO_PUBLIC_APP_NAME=UKTextiles
