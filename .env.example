# Copy this file to .env and fill in real values for local development.
# .env is only used by `npx expo start` (local Metro bundler).
# Cloud EAS builds do NOT read this file — see DEPLOYMENT.md, the same
# EXPO_PUBLIC_API_URL value must also be set in eas.json's per-profile
# "env" block, or the built APK will call the wrong backend.

# Django REST API base URL. Must be reachable from the phone (same WiFi
# as the Django server for local dev; a public HTTPS URL for real builds).
EXPO_PUBLIC_API_URL=http://192.168.0.56:8000/api

# Currently informational only — not read anywhere in app source. The
# app's actual display name/label comes from app.json's expo.name field.
# Kept here for future use; safe to ignore.
EXPO_PUBLIC_APP_NAME=UKTextiles
