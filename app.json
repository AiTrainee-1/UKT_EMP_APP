{
  "expo": {
    "name": "uktextiles",
    "slug": "ukt-team",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "uktextiles",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.uktex.employee",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "package": "net.uktex.employee",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f97316"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UKTextiles uses your location to verify attendance punches at your branch, and — only if HR enables it for your account — to show your live location on the HR dashboard while you're on duty."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "UKTextiles needs camera access to take the two verification photos required when you punch attendance from outside your branch's location.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f6fafe"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1105939-f606-42ec-93ee-9fb6ece30c76"
      }
    },
    "owner": "ukt"
  }
}
